# Demo defaults: local JSON, sample earnings, non-redeemable coupons.
DATA_MODE=demo
APP_ORIGIN=http://localhost:3000
# Required together for DATA_MODE=supabase. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CONTACT_HASH_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
# Coupon provisioning and order credit settlement deliberately remain adapters.
# Configure these before implementing the production worker.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
DEMO_DATA_FILE=.data/demo.json
